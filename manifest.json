{"schema":"pv-safety-data/1","built":"2026-11-08T13:20:02.437Z","scope":"manifest","keyed":true,"requests":{"used":16390,"budget":100000},"database":{"total":21054159,"lastUpdated":"2026-10-28"},"windows":{"end":"2026Q3","recent":{"from":"20251001","to":"20260930"},"prior":{"from":"20231001","to":"20250930"}},"sources":[{"id":"openfda-drug-event","name":"openFDA drug adverse events (FAERS)","page":"https://open.fda.gov/apis/drug/event/","limits":"Suspected reports submitted to FDA. Counts are not incidence, can include duplicates and do not establish causation. Reporting depends on time on market, publicity and use. Reports name the ingredient in any role (suspect or concomitant). Only drugs whose FDA harmonized generic name exactly matches the ingredient are counted; combination products are not included.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"openfda-drug-label","name":"openFDA drug labels","page":"https://open.fda.gov/apis/drug/label/","limits":"Up to five current label records per ingredient are searched for the reaction wording. A miss means the words were not found, not that the reaction is unlabelled.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"openfda-drug-enforcement","name":"openFDA drug enforcement reports (recalls)","page":"https://open.fda.gov/apis/drug/enforcement/","limits":"FDA Enforcement Report entries from 2004. Matched by openFDA harmonized generic name; recalls without harmonized fields are missed.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"openfda-label-changes","name":"openFDA drug labels (weekly change check)","page":"https://open.fda.gov/apis/drug/label/","limits":"Brand (NDA) and biologic (BLA) labels of Company Explorer companies. A change is reported when a label set's version moves on between weekly checks, with the sections whose text changed. Generic (ANDA) labels are not followed. Detection date is not the FDA approval date of the change.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"openfda-device-event","name":"openFDA device adverse events (MAUDE)","page":"https://open.fda.gov/apis/device/event/","limits":"Medical device reports matched by manufacturer name to Company Explorer companies (holder names of 5+ characters). Reports are not incidence, can be duplicated and include malfunctions without patient harm. A name match can include unrelated firms with similar names.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"openfda-device-enforcement","name":"openFDA device enforcement reports (recalls)","page":"https://open.fda.gov/apis/device/enforcement/","limits":"FDA Enforcement Report device entries from the last 12 months, matched by recalling firm name. Newest 25 per company.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"openfda-drug-shortages","name":"openFDA drug shortages","page":"https://open.fda.gov/apis/drug/drugshortages/","limits":"FDA drug shortage records matched by openFDA harmonized generic name. Status is as FDA reports it.","lastSuccess":"2026-11-08T13:20:02.437Z"},{"id":"ema-dhpc","name":"EMA direct healthcare professional communications (DHPC)","page":"https://www.ema.europa.eu/en/medicines/download-medicine-data","limits":"DHPCs published by EMA for centrally authorised medicines. Nationally agreed DHPCs are not included. Matched by medicine name, then by active substance.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"ema-psusa","name":"EMA periodic safety update single assessments (PSUSA)","page":"https://www.ema.europa.eu/en/medicines/download-medicine-data","limits":"PSUSA outcomes EMA publishes. An outcome applies to the active substance, so it is shown for every company with an EU authorisation of that substance in Company Explorer.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"ema-referral","name":"EMA referrals","page":"https://www.ema.europa.eu/en/medicines/download-medicine-data","limits":"EU referral procedures with their status. Not every referral is about safety; the referral type is shown.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"ema-shortage","name":"EMA medicine shortages","page":"https://www.ema.europa.eu/en/medicines/download-medicine-data","limits":"Shortages EMA reports publicly, mainly of centrally authorised medicines. National shortage registers are not included.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"hc-recalls","name":"Health Canada recalls and safety alerts","page":"https://recalls-rappels.canada.ca/en","limits":"Health product entries from the Recalls and Safety Alerts open data (Open Government Licence - Canada). Matched by ingredient or brand words in the title and product; name matches need review.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"mhra-alerts","name":"MHRA drug and medical device alerts and recalls","page":"https://www.gov.uk/drug-device-alerts","limits":"Alerts and recalls MHRA publishes on GOV.UK (Open Government Licence). Matched by ingredient or brand words in the title and by the company named in the title; name matches need review. Weekly field safety notice lists are only kept when a name matches.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"hc-dpd","name":"Health Canada Drug Product Database (marketed products)","page":"https://www.canada.ca/en/health-canada/services/drugs-health-products/drug-products/drug-product-database.html","limits":"Used only to attribute Health Canada recalls and alerts to companies: a brand named in the item is matched to the company the DPD lists for it. Only marketed products; company names are matched to Company Explorer holder names and need review.","lastSuccess":"2026-11-08T13:20:02.437Z","ok":true},{"id":"dailymed-spl-updates","name":"DailyMed SPL updates (twice-daily label change check)","page":"https://dailymed.nlm.nih.gov/dailymed/webservices-help/v2/spls_api.cfm","limits":"Followed labels are the brand (NDA) and biologic (BLA) labels of Company Explorer companies found by the weekly openFDA check. A change is reported when DailyMed publishes a newer SPL version, with the sections whose text changed against the previous version. Publication on DailyMed is not the FDA approval date of the change.","lastSuccess":"2026-11-08T22:34:53.399Z","ok":true},{"id":"pmda-safety","name":"PMDA safety information (English RSS feed)","page":"https://www.pmda.go.jp/english/safety/info-services/drugs/0001.html","limits":"Safety items ([ANZEN]) from PMDA's English news feed: Revisions of PRECAUTIONS, Risk Communications, MHLW safety information and similar notices, linked to PMDA. Source: Pharmaceuticals and Medical Devices Agency (PMDA). PMDA's English pages are machine translated and the documents are in Japanese. Only the feed is read; the feed keeps about 45 recent items, so older notices are kept from earlier checks. Matched by ingredient words in the title (titles often name one ingredient and \"etc.\"); a substance match does not mean a company's Japanese product is affected.","lastSuccess":"2026-11-08T22:34:53.399Z","ok":true}],"counts":{"inScope":1786,"published":1786,"collected":1786,"retained":0,"failed":0,"skipped":0,"labelApplications":2760,"labelsTracked":1866,"labelChanges":0,"alerts":1695,"alertSourcesFailed":0,"canadianBrands":2281,"deviceCompanies":122,"devices":{"collected":122,"retained":0,"failed":0,"skipped":0}},"blocked":null,"files":[{"name":"safety-00","path":"safety-00.json.gz","sha256":"19d74d3443efc105612bb036e93ec68f7b28b9a612fdfabca735d83b666110b7","bytes":34768,"rawBytes":210300,"url":"https://raw.githubusercontent.com/chalamalasetti/pvinfo-data/f86aa0404386ecdab8d7d635ca3dce3d769f8d15/safety-00.json.gz"},{"name":"safety-01","path":"safety-01.json.gz","sha256":"fa2ad372c9677d5fde70c1c5e7a5a87af85342c3cdaca443b8de259a8dd74086","bytes":35547,"rawBytes":206635,"url":"https://raw.githubusercontent.com/chalamalasetti/pvinfo-data/f86aa0404386ecdab8d7d635ca3dce3d769f8d15/safety-01.json.gz"},{"name":"safety-02","path":"safety-02.json.gz","sha256":"92a8ef0e20010a790a7a8a60479fced6a