  {
   "id": "d93b1d6f-dab4-410a-90c9-32876c75220e",
   "document_version_id": "cd98002e-57e7-40a9-b946-d5f3f155b1b4",
   "verdict": "revise",
   "failed_checks": [
    "statement_faithful"
   ],
   "reason": "Statement was a raw list fragment without the actor (lead-in of para 1027 is \"The MA holder shall\").",
   "row": {
    "statement": "The MA holder shall include information on the additional monitoring status in materials distributed to healthcare professionals and patients, encouraging adverse reaction reporting as agreed with the Member States’ authorised authorities, and shall provide those authorities with information on fulfilment of the conditions they established.",
    "confidence": 90
   }
  },
  {
   "id": "66944b88-c39e-446c-a093-54355056695b",
   "document_version_id": "cd98002e-57e7-40a9-b946-d5f3f155b1b4",
   "verdict": "revise",
   "failed_checks": [
    "statement_faithful"
   ],
   "reason": "Statement was a raw list fragment without the actor (lead-in of para 1027 is \"The MA holder shall\").",
   "row": {
    "statement": "The MA holder shall submit changes to the SmPC and package insert to include or remove the black triangle symbol and the accompanying additional monitoring statement, following the EAEU Rules for Marketing Authorisation and Expert Assessment and the SmPC/package insert requirements (EEC Council Decision No. 88 of 3 November 2016).",
    "confidence": 90
   }
  },
  {
   "id": "ee1557ea-5a9f-4cd5-abb6-cf85ee738cdd",
   "document_version_id": "cd98002e-57e7-40a9-b946-d5f3f155b1b4",
   "verdict": "revise",
   "failed_checks": [
    "quote_clean",
    "statement_faithful"
   ],
   "reason": "Quote and statement cut off the explanatory note mid-text, omitting its final sentence asking HCPs to report suspected adverse reactions.",
   "row": {
    "statement": "For products on the additional monitoring list, the SmPC and package insert must contain the inverted black triangle with the note: \"This medicinal product is subject to additional monitoring. This will allow you to identify new safety information quickly. We are asking healthcare professionals to report any suspected adverse reactions.\"",
    "quote": "1028. For the medicinal products included in the list of medicinal\nproducts subject to additional monitoring, the summary of product\ncharacteristics and package insert must contain the symbol of an inverted\nblack isosceles triangle (), which is accompanied by the following\nexplanatory note: “This medicinal product is subject to additional monitoring.\nThis will allow you to identify new safety information quickly. We are asking\nhealthcare professionals to report any suspected adverse reactions.”",
    "confidence": 92
   }
